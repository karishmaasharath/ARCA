{
  "name": "arca-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "sdk",
    "dashboard",
    "extension"
  ],
  "scripts": {
    "dev:sdk": "npm run dev --workspace=sdk",
    "build:sdk": "npm run build --workspace=sdk",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "build:dashboard": "npm run build --workspace=dashboard",
    "build:extension": "npm run build --workspace=extension",
    "build": "npm run build:sdk && npm run build:dashboard && npm run build:extension"
  }
}
